# Replace an issue's TITLE and/or DESCRIPTION in place — the counterpart to `comment` (AGT-216). Both
# are the ticket's current state ("now"); comments are how it got here. So neither posts a comment, and
# both live on the same verb: a ticket renamed to the house `TEAM-N (Type): <action>` form once its id
# is known (AGT-232) is usually being re-described in the same breath, and one `edit` call does it in
# one command instead of two.
#
# Flags only, no positional body: a whole-body replace is destructive, so it must be explicit. Rich
# markdown goes through `--desc-file -` with a SINGLE-quoted heredoc, the same robust path `comment`
# uses. Prints the title old → new and the description char delta so an accidental clobber (3891 → 12)
# is visible; an empty title or body is refused by the client, not applied.
#
# The two fields are two mutations (`retitle` + `edit_description`), exactly as the admin endpoint's
# PATCH runs them — one client, one order, so the CLI and the HTTP surface stay in lock-step. Blank
# values are therefore caught HERE, before either fires: a `--title ""` that aborted after the
# description had already been replaced would leave a half-applied edit, and the client's guard alone
# can only refuse the call it is given.
def cmd_edit(args)
  usage = usage_for("edit")
  identifier = args.shift or abort usage
  title = nil
  description = nil
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--title"                           then title       = named_value!(args, i, "--title", "edit", "title"); i += 2
    when "--desc", "--description"           then description = args[i + 1]; i += 2
    when "--desc-file", "--description-file" then description = read_body_file(args[i + 1]); i += 2
    when /\A--/                              then unknown << args[i]; i += 1
    else i += 1
    end
  end
  reject_unknown_flags!(unknown, "edit")
  abort usage if title.nil? && description.nil?
  abort "Refusing to replace the title with an empty one — pass the new title via --title" \
    if title && title.strip.empty?
  abort "Refusing to replace the description with an empty body — pass the new body via --desc/--desc-file" \
    if description && description.strip.empty?

  url = nil
  if title
    res     = CLIENT.retitle(identifier, title)
    updated = res[:issue]
    url     = updated["url"]
    puts "#{updated["identifier"]}: \"#{res[:old_title]}\" → \"#{updated["title"]}\""
  end

  if description
    res     = CLIENT.edit_description(identifier, description)
    updated = res[:issue]
    url     = updated["url"] || url
    puts "#{updated["identifier"]}: description replaced " \
         "(#{res[:old_description].to_s.length} → #{description.length} chars)"
    dropped, dropped_from = res[:dropped_images], updated["identifier"]
  end

  # One URL for the whole edit, printed last, so a title+desc call reads as one change rather than two.
  puts url if url
  warn_dropped_images(dropped_from, dropped) if dropped
end

# Screenshots live INSIDE the description — `create --image` uploads each one and embeds the markdown in
# the body (there is no separate attachment field) — so a whole-body replace can delete a ticket's only
# repro image with nothing but a smaller char delta to show for it. That silently defeats the evidence
# rule (AGT-66: report, repro and QA screenshots belong ON the ticket). We WARN rather than block or
# re-append: replacing the whole body IS `edit`'s contract, and `edit` must stay non-interactive because
# a board tick calls it unattended. Goes to stderr so stdout stays parseable. (AGT-219)
def warn_dropped_images(identifier, dropped)
  dropped = Array(dropped)
  return if dropped.empty?

  # stdout is block-buffered when piped while stderr is not, so flush first or the warning surfaces
  # ABOVE the "description replaced" line it annotates.
  $stdout.flush
  warn "  ! dropped #{dropped.size} embedded image(s) — the replaced description carried screenshots " \
       "this body does not (AGT-66: evidence belongs on the ticket)"
  dropped.each { |url| warn "    - #{url}" }
  warn "    those asset URLs are still live — re-embed as ![name](url) in the new body, " \
       "or add fresh evidence with: #{PROG} attach #{identifier} PATH"
end

def cmd_close(args)
  usage = usage_for("close")
  identifier = args.shift or abort usage
  comment = comment_file = nil
  positionals = []
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--comment"      then comment      = flag_value!(args, i, "--comment", "close"); i += 2
    when "--comment-file" then comment_file = flag_value!(args, i, "--comment-file", "close"); i += 2
    # POSIX end-of-options, as `comment` has it (AGT-201): everything after a bare `--` is the body,
    # so a reason that itself opens with `--` isn't misread as an unknown flag.
    when "--"             then positionals.concat(args[(i + 1)..] || []); break
    when /\A--/           then unknown << args[i]; i += 1
    else positionals << args[i]; i += 1
    end
  end
  reject_unknown_flags!(unknown, "close")
  comment = resolve_comment_flags!(comment, comment_file, cmd: "close", positionals: positionals)

  res = CLIENT.transition(identifier, :done, comment: comment)
  updated = res[:issue]
  puts "Closed #{updated["identifier"]}: #{updated["title"]} → #{updated.dig("state", "name")}"
  puts updated["url"]
  puts "Comment added." if comment
end

def cmd_list(args)
  status_filter = nil
  label_filter  = nil
  team_key      = default_team
  limit         = nil
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--status" then status_filter = named_value!(args, i, "--status", "list", "status"); i += 2
    when "--label"  then label_filter  = named_value!(args, i, "--label", "list", "label name"); i += 2
    when "--team"   then team_key      = named_value!(args, i, "--team", "list", "team key"); i += 2
    when "--limit"  then limit         = named_value!(args, i, "--limit", "list", "count"); i += 2
    when /\A--/     then unknown << args[i]; i += 1
    else i += 1
    end
  end
  # `list` had no unknown-flag branch at all, so `list --stat done` stepped over the typo and returned
  # EVERY issue — a wrong answer wearing a right answer's clothes (AGT-275).
  reject_unknown_flags!(unknown, "list")

  # A typo'd --limit must not coerce to 0 and print "No issues found." — that is the same silent
  # wrong answer, in miniature, that AGT-224 was filed for.
  limit = positive_int!(limit, "list", "--limit") if limit

  # No --limit means EVERY matching issue, however many pages that takes (AGT-224). --limit is the
  # opt-in for a caller that only wants the oldest N and would rather not page a whole team for them
  # (e.g. a `--status done` lane thousands deep); it is never a default, because a quietly capped list
  # is the bug this command was fixed for.
  issues = CLIENT.list(status: status_filter, label: label_filter, team: team_key, limit: limit)
  if issues.empty?
    puts "No issues found."
    return
  end

  issues.each do |issue|
    pri       = CLIENT.priority_label(issue["priority"])
    label_str = issue.dig("labels", "nodes")&.map { |l| l["name"] }&.join(",")
    label_str = label_str && !label_str.empty? ? " [#{label_str}]" : ""
    puts "#{issue["identifier"].ljust(8)} #{issue.dig("state", "name").ljust(12)} #{pri.ljust(8)} #{issue["title"]}#{label_str}"
  end
end

