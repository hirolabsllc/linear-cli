# The In Review comment for a --sha. Every clause has to be something the tool can actually show is
# true (AGT-212): `review` moves an issue to In Review, which by definition is NOT "merged to main",
# and the ticket comment is the permanent record a later reader — or a closeout session — uses to
# decide whether the work shipped. So the merge claim is taken from git (or from the caller, via
# --merged/--not-merged), and the deploy clause only follows a commit that actually landed, in a repo
# that actually deploys.
#
# None of the non-merged wordings contain the word "merged": "not merged to main" reads as the claim
# to a skim or a grep, which is how a one-line status sentence gets read at all.
def review_comment(ref, repo: nil, merged: nil, deploy: nil)
  commit = resolve_commit(ref, repo: repo)
  state  = case merged
           when true  then :merged
           when false then commit.state == :merged ? :pushed : commit.state
           else commit.state
           end

  branch   = commit.branch.to_s.sub(%r{\Aorigin/}, "")
  branch   = "main" if branch.empty?
  platform = deploy_platform(commit.slug)
  show_deploy = deploy.nil? ? (state == :merged && platform != :none) : deploy
  clause   = show_deploy ? " — #{platform.is_a?(String) ? "#{platform} " : ""}deploy in progress" : ""

  case state
  when :merged then "Merged to #{branch}: #{commit.markdown} | #{ts}#{clause}"
  when :pushed then "Pushed for review (not on #{branch} yet): #{commit.markdown} | #{ts}#{clause}"
  when :local  then "Commit under review (not pushed): #{commit.markdown} | #{ts}#{clause}"
  else "Commit under review: #{commit.markdown} | #{ts}#{clause}"
  end
end

def cmd_review(args)
  usage = usage_for("review")
  identifier = args.shift or abort usage
  sha = repo = merged = deploy = nil
  positionals = []
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--sha"        then sha    = flag_value!(args, i, "--sha", "review");  i += 2
    when "--repo"       then repo   = flag_value!(args, i, "--repo", "review"); i += 2
    when "--merged"     then merged = true;  i += 1
    when "--not-merged" then merged = false; i += 1
    when "--deploy"     then deploy = true;  i += 1
    when "--no-deploy"  then deploy = false; i += 1
    when /\A--/         then unknown << args[i]; i += 1
    else positionals << args[i]; i += 1
    end
  end
  reject_unknown_flags!(unknown, "review")
  # `review` has no body — a bare word here is almost always a SHA that lost its --sha, and stepping
  # over it moved the issue to In Review with no commit recorded at all (AGT-277).
  reject_unknown_positionals!(positionals, "review", usage)

  body = sha && review_comment(sha, repo: repo, merged: merged, deploy: deploy)
  res  = CLIENT.transition(identifier, :in_review, comment: body)
  puts "#{identifier} → #{res[:issue].dig("state", "name")}"
  puts "Comment: #{body}" if body
end

# Attach a commit to an issue as a comment with a clickable GitHub link + subject. Defaults to HEAD —
# run it after every `git commit` tied to the issue so the ticket carries a linked trail of each
# commit (not just the final merge SHA). Does NOT change state. --note adds a caption line above.
# The link is omitted rather than guessed when the ref isn't a commit in this checkout; --repo
# owner/name links a commit that lives in another repo (AGT-212).
def cmd_commit(args)
  identifier = args.shift or abort usage_for("commit")
  ref  = "HEAD"
  note = repo = nil
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--sha"  then ref  = named_value!(args, i, "--sha", "commit", "ref"); i += 2
    when "--note" then note = flag_value!(args, i, "--note", "commit"); i += 2
    when "--repo" then repo = named_value!(args, i, "--repo", "commit", "owner/name"); i += 2
    when /\A--/   then unknown << args[i]; i += 1
    else i += 1
    end
  end
  # `commit` had no guard either, and its failure LIES on the permanent trail: `commit ISSUE-N --sah
  # abc` stepped over the typo, fell back to HEAD, and posted the wrong commit to the ticket as fact
  # — the one place a later reader looks to decide what shipped (AGT-275).
  reject_unknown_flags!(unknown, "commit")

  md   = commit_markdown(ref, repo: repo)
  body = join_md(note, "Commit: #{md} | #{ts}")
  CLIENT.comment(identifier, body)
  puts "#{identifier}: commit linked — #{md}"
end

def cmd_label(args)
  identifier = take_positional!(args, "label", "issue id")
  label_name = take_positional!(args, "label", "label name")
  CLIENT.add_labels(identifier, [label_name])
  puts "#{identifier}: label '#{label_name}' applied."
end

def cmd_cancel(args)
  usage = usage_for("cancel")
  identifier = args.shift or abort usage
  comment = comment_file = nil
  positionals = []
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--comment"      then comment      = flag_value!(args, i, "--comment", "cancel"); i += 2
    when "--comment-file" then comment_file = flag_value!(args, i, "--comment-file", "cancel"); i += 2
    when "--"             then positionals.concat(args[(i + 1)..] || []); break
    when /\A--/           then unknown << args[i]; i += 1
    else positionals << args[i]; i += 1
    end
  end
  reject_unknown_flags!(unknown, "cancel")
  comment = resolve_comment_flags!(comment, comment_file, cmd: "cancel", positionals: positionals)

  res = CLIENT.transition(identifier, :canceled, comment: comment)
  updated = res[:issue]
  puts "Canceled #{updated["identifier"]} → #{updated.dig("state", "name")}"
  # Say so explicitly: a transition line on its own is exactly what a swallowed body looked like.
  puts "Comment added." if comment
end

# Full-text dedup search — relevance-ranked across title + description, ALL states (Done/Canceled
# included) so reopen/link candidates surface. Run this BEFORE `create` to avoid filing a duplicate.
def cmd_search(args)
  term  = take_positional!(args, "search", "search term")
  limit = 10
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    # `.to_i` made `--limit abc` mean 10 → 0 and printed "safe to create a new one", which is how a
    # duplicate gets filed by the very command that exists to prevent one (AGT-275).
    when "--limit" then limit = positive_int!(named_value!(args, i, "--limit", "search", "count"), "search", "--limit"); i += 2
    when /\A--/    then unknown << args[i]; i += 1
    else i += 1
    end
  end
  reject_unknown_flags!(unknown, "search")

  issues = CLIENT.search(term, limit: limit)
  if issues.empty?
    puts "No candidates for #{term.inspect} — safe to create a new one."
    return
  end

  # searchIssues is fuzzy/relevance-ranked — it returns loose matches even for unrelated terms, so
  # these are CANDIDATES to judge, not confirmed dups. Only act on a TRUE match.
  puts "#{issues.length} candidate(s) for #{term.inspect} (relevance-ranked — judge before creating):"
  puts "  ↳ true match? reopen a Done/Canceled one (⟲), or relate/cancel-as-duplicate an open one — don't create a dup."
  puts
  issues.each do |issue|
    pri       = CLIENT.priority_label(issue["priority"])
    label_str = issue.dig("labels", "nodes")&.map { |l| l["name"] }&.join(",")
    label_str = label_str && !label_str.empty? ? " [#{label_str}]" : ""
    # Flag the states that are reopen candidates so a skimming agent/human notices.
    state     = issue.dig("state", "name")
    flag      = %w[completed canceled].include?(issue.dig("state", "type")) ? " ⟲" : ""
    puts "#{issue["identifier"].ljust(8)} #{(state + flag).ljust(14)} #{pri.ljust(8)} #{issue["title"]}#{label_str}"
    puts "         #{issue["url"]}"
  end
end

# Move a Done/Canceled (or any) issue back to Todo/In Progress — for a recurrence of already-closed
# work. Keeps the original repro, history, and merged-SHA trail. Defaults to Todo; --in-progress
# reopens straight to active.
def cmd_reopen(args)
  usage = usage_for("reopen")
  identifier = args.shift or abort usage
  to_progress = false
  comment = comment_file = nil
  positionals = []
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--in-progress", "--in_progress" then to_progress = true; i += 1
    when "--comment"                      then comment      = flag_value!(args, i, "--comment", "reopen"); i += 2
    when "--comment-file"                 then comment_file = flag_value!(args, i, "--comment-file", "reopen"); i += 2
    when "--"                             then positionals.concat(args[(i + 1)..] || []); break
    when /\A--/                           then unknown << args[i]; i += 1
    else positionals << args[i]; i += 1
    end
  end
  reject_unknown_flags!(unknown, "reopen")
  comment = resolve_comment_flags!(comment, comment_file, cmd: "reopen", positionals: positionals)

  body = comment || "Reopened — recurrence of previously-closed work. #{ts}"
  res  = CLIENT.reopen(identifier, to_progress: to_progress, comment: body)
  puts "#{identifier}: #{res[:from]} → #{res[:to]} (reopened)"
  puts "Comment: #{body}"
end

# Create a real Linear relation between two issues (shows in the UI, unlike a text "duplicate of
# ISSUE-X" comment). --type related (default), blocks, blocked-by, duplicate, or similar. For an
# epic→sub-ticket breakdown use the `parent` command instead.
def cmd_relate(args)
  usage = usage_for("relate")
  a = args.shift or abort usage
  b = args.shift or abort usage
  type = "related"
  positionals = []
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--type" then type = flag_value!(args, i, "--type", "relate").downcase; i += 2
    when /\A--/   then unknown << args[i]; i += 1
    else positionals << args[i]; i += 1
    end
  end
  reject_unknown_flags!(unknown, "relate")
  # `relate` takes exactly two ids — a third bare word is a --type value that lost its flag
  # (`relate A B duplicate`), and stepping over it created a plain "related" link instead (AGT-277).
  reject_unknown_positionals!(positionals, "relate", usage)

  res = CLIENT.relate(a, b, type: type)
  if res[:type] == "blocked-by"
    puts "#{a} blocked by #{b}."
  else
    verb = case res[:type]
           when "duplicate" then "marked as duplicate of"
           when "blocks"    then "blocks"
           when "similar"   then "marked similar to"
           else "related to"
           end
    puts "#{a} #{verb} #{b}."
  end
end

# Make CHILD a sub-issue of PARENT — Linear's native epic hierarchy, the right model for an
# epic broken into numbered sub-tickets (e.g. "Radar 1/6..6/6"). Unlike `relate`, this shows as a
# real parent/sub-issue with progress rollup.
def cmd_parent(args)
  child  = args.shift or abort usage_for("parent")
  parent = args.shift or abort usage_for("parent")
  CLIENT.set_parent_by_identifier(child, parent)
  puts "#{child} is now a sub-issue of #{parent}."
end

# Remove any relation(s) between two issues (the inverse of `relate`) — e.g. to clean up a link
# created in error. Deletes in both directions if present.
def cmd_unrelate(args)
  a = args.shift or abort usage_for("unrelate")
  b = args.shift or abort usage_for("unrelate")
  count = CLIENT.unrelate(a, b)
  abort "No relation between #{a} and #{b}." if count.zero?

  puts "Removed #{count} relation(s) between #{a} and #{b}."
end

# Dispatch one CLI invocation. Wrapped in a method (rather than bare top-level code) with a guarded
# autorun at the bottom so the file can be `load`ed in tests (LINEAR_CLI_SKIP_MAIN=1) to exercise the
# cmd_* / read_body_file helpers WITHOUT running a command or hitting the network. The `bin/linear`
# shim `load`s this file in production, where the env flag is unset, so `run(argv)` fires normally.
def run(argv = ARGV)
  command = argv.shift

  # Answer `--help` / `-h` on a known subcommand HERE — before its parser can shift the token in as a
  # title, a label or a comment body — with that subcommand's own usage, and exit 0. See
  # help_requested? for why this token in particular earns a gate of its own (AGT-276).
  if SUBCOMMAND_USAGE.key?(canonical_subcommand(command)) && help_requested?(argv)
    puts usage_for(command)
    puts "Run `#{PROG}` with no arguments for the full command list."
    exit 0
  end

  # `#{PROG} help <subcommand>` — the same text by the other spelling. Without this it fell through
  # to the full command list, which answers a different question than the one that was asked.
  if command == "help" && !argv.empty?
    sub = argv.first
    unless SUBCOMMAND_USAGE.key?(canonical_subcommand(sub))
      abort "#{PROG}: unknown command #{sub.inspect} — run `#{PROG}` with no args for the command list."
    end

    puts usage_for(sub)
    exit 0
  end

  case command
  when "create"  then cmd_create(argv)
  when "view"    then cmd_view(argv)
  when "url"     then cmd_url(argv)
  when "retitle", "rename" then cmd_retitle(argv)
  when "priority", "prio"   then cmd_priority(argv)
  when "set"     then cmd_set(argv)
  when "edit", "edit-desc" then cmd_edit(argv)
  when "close"   then cmd_close(argv)
  when "cancel"  then cmd_cancel(argv)
  when "list"    then cmd_list(argv)
  when "search"  then cmd_search(argv)
  when "reopen"  then cmd_reopen(argv)
  when "parent"  then cmd_parent(argv)
  when "relate"  then cmd_relate(argv)
  when "unrelate" then cmd_unrelate(argv)
  when "comment" then cmd_comment(argv)
  when "comments"        then cmd_comments(argv)
  when "comment-edit"    then cmd_comment_edit(argv)
  when "comment-delete"  then cmd_comment_delete(argv)
  when "attach"  then cmd_attach(argv)
  when "commit"  then cmd_commit(argv)
  when "start"   then cmd_start(argv)
  when "review"  then cmd_review(argv)
  when "label"   then cmd_label(argv)
  else
    puts <<~USAGE
      #{PROG} — Linear issue CLI (linear_cli gem; default team #{default_team || "(set $LINEAR_DEFAULT_TEAM or use --team)"})

      Multi-team: the workspace may have several teams. create/list default to
      #{default_team || "$LINEAR_DEFAULT_TEAM"} (override with --team KEY, or set $LINEAR_DEFAULT_TEAM). Every other command takes an
      issue id (e.g. ENG-123) and resolves its team automatically — no --team needed.

      Commands:
        create  "Title" [--team KEY] [--label Bug|Feature|Infrastructure|Ops] [--priority urgent|high|medium|low] [--desc "body" | --desc-file PATH|-] [--image PATH ...]
                [--parent ISSUE-N] [--blocked-by ISSUE-N] [--blocks ISSUE-N] [--related ISSUE-N]   ← link deps AT create time
        search  "<keywords>" [--limit N]             full-text dedup search (ALL states; run BEFORE create)
        list    [--status todo|in_progress|done] [--label Bug] [--team KEY] [--limit N]
                └─ returns EVERY matching issue (paginated); --limit N caps it at the oldest N
        view    ISSUE-N                                shows parent/sub-issues/relations under "Links:"
        url     ISSUE-N
        retitle ISSUE-N "New title"                     change an issue's title (alias: rename); prints old → new
                └─ renaming to the house TEAM-N (Type): <action> form once the id is known? `edit --title`
                   does it alongside a --desc replace in one call.
        priority ISSUE-N urgent|high|medium|low|none    change priority (alias: prio); prints old → new
        set     ISSUE-N [--priority X] [--assignee me|email] [--estimate N] [--due YYYY-MM-DD] [--label NAME]   set field(s) in one call
        edit    ISSUE-N [--title "New title"] [--desc "body" | --desc-file PATH|-]   REPLACE the title
                and/or description in place, in ONE call (posts NO comment)
                └─ title + description = the current state ("now"); comments = how it got here. Rich markdown? use
                   --desc-file -  with a SINGLE-quoted heredoc:  #{PROG} edit ISSUE-N --desc-file - <<'MD' … MD
        reopen  ISSUE-N [--in-progress] ["why" | --comment "why" | --comment-file PATH|-]   move a Done/Canceled issue back
        parent  CHILD PARENT                  make CHILD a sub-issue of an epic (native hierarchy + rollup)
        relate  ISSUE-N ISSUE-M [--type related|blocks|blocked-by|duplicate|similar]   link two issues (real Linear relation)
        unrelate ISSUE-N ISSUE-M                          remove the relation(s) between two issues (inverse of relate)
        start   ISSUE-N [--session "session name"]     move to In Progress + log session attribution
        review  ISSUE-N [--sha <sha>] [--repo owner/name] [--merged|--not-merged] [--deploy|--no-deploy]
                └─ move to In Review + log the SHA. The comment claims only what git can show: "Merged to
                   main" ONLY when the SHA is on origin's default branch, and a deploy clause only for a repo
                   that deploys ($LINEAR_CLI_DEPLOY_REPOS). --merged/--not-merged take the claim from you.
        commit  ISSUE-N [--sha <ref>] [--note "..."] [--repo owner/name]   link a commit (clickable GitHub
) +
   %(                link + subject; default HEAD). The repo comes from THIS checkout's origin remote; a SHA that
                isn't a commit here is posted WITHOUT a link (a 404 on the trail is worse) — name it with --repo.
        comment ISSUE-N "body" | --body-file PATH|- [--image PATH ...]   add a comment (QA result, notes, etc.)
                └─ rich multi-line markdown? use  --body-file -  with a SINGLE-quoted heredoc so the shell
                   can't mangle backticks/$/\:   #{PROG} comment ISSUE-N --body-file - <<'MD' … MD
        comments        ISSUE-N                          list this issue's comments + their ids
        comment-edit    ISSUE-N <comment-id> "new body" | --body-file PATH|-   edit a comment
        comment-delete  ISSUE-N <comment-id>            delete a comment (e.g. a stray/mistaken one)
        attach  ISSUE-N PATH [PATH ...] [--note "..."]  attach screenshot(s) — repro/QA evidence
        label   ISSUE-N <label>                         add a label (auto-creates it if missing)
        close   ISSUE-N ["reason" | --comment "reason" | --comment-file PATH|-]   mark Done (verified on prod)
                └─ a closing writeup is the LONGEST body in the lifecycle and full of backticks — pass it as
                   --comment-file -  with a SINGLE-quoted heredoc:  #{PROG} close ISSUE-N --comment-file - <<'MD' … MD
                └─ a one-liner can go in as a plain quoted argument, exactly like `comment ISSUE-N "body"` —
                   QUOTE it as one argument, and don't combine it with --comment/--comment-file (AGT-277).
        cancel  ISSUE-N ["reason" | --comment "reason" | --comment-file PATH|-]   mark Canceled (duplicates / won't-do)

      Every subcommand takes --help / -h — `#{PROG} create --help` prints just that command's
      arguments and does nothing else. A leading `--` escapes the next token, so a title or label that
      genuinely starts with dashes is still expressible: `#{PROG} create -- --dashy-title --label Bug`.

      Labels auto-create on first use, so --label Bug works even before the label exists.

      Dependencies (link them AT create time so they're never forgotten):
        --parent ISSUE-N      sub-issue of an epic (epic breakdown — use this for "X 1/6..6/6")
        --blocked-by ISSUE-N  this ticket depends on ISSUE-N (can't ship until ISSUE-N does)
        --blocks ISSUE-N      this ticket must ship before ISSUE-N
        --related ISSUE-N     sibling / same-root-cause follow-up (no hard ordering)

      Lifecycle:
        search (dedup) → create [+link deps] → start (picked up) → commit (after each commit) → review --sha (In Review) → comment (QA) → close (prod verified)
        └─ link every commit tied to the issue with `commit ISSUE-N` so the ticket carries a clickable GitHub trail.
        └─ on a match: `reopen` a Done/Canceled one, or `relate`/`cancel --type duplicate` instead of creating a dup.

      Config is env-only: LINEAR_API_KEY (required) + LINEAR_DEFAULT_TEAM (default create/list team) +
      LINEAR_CLI_DEPLOY_REPOS (owner/name[=Platform], comma-separated — which repos `review` may call deploying).
      A .env in the working directory is auto-loaded when the `dotenv` gem is available.

      Requires LINEAR_API_KEY — get one at linear.app/settings/api
    USAGE
    # A MISTYPED command must not exit 0 having done nothing: to a script — a board tick, a CI step,
    # a `set -e` shell function — that is indistinguishable from success, so `linear crate "Title"`
    # reported that it had filed a ticket it never filed. A bare `#{PROG}`, `help` and `--help` are a
    # real request for this text and still exit 0 (AGT-275).
    unless command.nil? || %w[help --help -h].include?(command)
      $stdout.flush   # stdout is block-buffered when piped; stderr is not
      warn "#{PROG}: unknown command #{command.inspect}"
      exit 1
    end
  end
rescue Linear::Client::UsageLimited => e
  # Terminal plan/usage limit (e.g. the free-plan active-issue cap). Surface Linear's own upgrade copy.
  warn "Linear error: #{e.message}"
  warn "  ↳ This workspace hit a Linear plan limit. Upgrade at linear.app/settings/billing or contact sales@linear.app, then retry."
  exit 1
rescue Linear::Client::RateLimited => e
  # The client already backed off + retried (MAX_ATTEMPTS) before giving up.
  warn "Linear error: #{e.message}"
  warn "  ↳ Linear is rate-limiting requests; the client already retried with backoff. Wait a moment and run it again."
  exit 1
rescue Linear::Client::Error => e
  # Typed errors from the shared client surface as a clean CLI failure (the client never exits/aborts).
  warn "Linear error: #{e.message}"
  exit 1
end

# Autorun unless a test loaded us purely to reach the helpers (see the note on `run`).
unless ENV["LINEAR_CLI_SKIP_MAIN"] == "1"
  # A gem tag does not ship itself, and four separate checkouts run this file — so before anything
  # else, say on stderr when THIS one is behind the newest tag it knows about, or has uncommitted
  # edits that every caller is executing live (AGT-222). Advisory only: it never blocks the command.
  # It lives in the gem rather than in each host's `bin/linear` so every shim inherits it.
  LinearCli::Checkout.warn!
  run(ARGV)
end
