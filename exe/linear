# Guard: the comment id must be one of ISSUE-N's comments — so a typo'd id or a wrong issue can't
# silently target someone else's comment. Aborts with a hint to `comments ISSUE-N` otherwise.
def ensure_comment_on_issue!(identifier, comment_id)
  return if CLIENT.comments(identifier).any? { |c| c["id"] == comment_id }

  abort "Comment #{comment_id} not found on #{identifier}. Run `#{PROG} comments #{identifier}` to list ids."
end

