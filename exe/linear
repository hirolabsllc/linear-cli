#!/usr/bin/env ruby
# frozen_string_literal: true
#
# linear — Linear issue management CLI (ships in the linear_cli gem).
#
# A THIN CLI over Linear::Client (the gem library). All Linear GraphQL + lifecycle conventions live in
# Linear::Client; this layer only parses args, prints stdout, and handles local files (git/images).
#
# Multi-team: the workspace may have several teams. create/list default to $LINEAR_DEFAULT_TEAM
# (override with --team KEY); every other command takes an issue id (e.g. ENG-123) and resolves its
# team automatically — no --team needed. Config is env-only:
#   LINEAR_API_KEY       (required)  — get one at linear.app/settings/api
#   LINEAR_DEFAULT_TEAM  (optional)  — default team key for create/list (e.g. ENG)
#
# Usage examples:
#   linear search "<keywords>" [--limit N]
#   linear create "Title" [--team KEY] [--label Bug|Feature|...] [--priority urgent|high|medium|low] [--desc "body"] ...
#   linear edit ISSUE-N --title "AGT-1 (Bug): fix X" --desc-file board.md   # replace title/description (no comment)
#   linear start ISSUE-N --session "..."   |   linear review ISSUE-N --sha <sha>   |   linear close ISSUE-N

require "net/http"
require "uri"
require "json"

# Soft-load a .env from the working directory when dotenv is available, so `linear` "just works" in a
# project checkout that keeps its key in .env. Falls back to the real environment otherwise (the
# canonical config path on servers). Never fatal if dotenv isn't installed.
begin
  require "dotenv"
  Dotenv.load(".env") if File.exist?(".env")
rescue LoadError
  # dotenv not present — read LINEAR_API_KEY / LINEAR_DEFAULT_TEAM straight from ENV.
end

require "linear_cli"

# This program's invoked name (`linear`, or `bin/linear` via a host shim) — used in usage strings.
PROG = File.basename($PROGRAM_NAME)

# Re-tag command-line args as UTF-8. When Encoding.default_external is US-ASCII, Ruby tags ARGV bytes
# as US-ASCII/ASCII-8BIT — a title/desc/note/comment containing a non-ASCII char (an em-dash, an arrow
# like ⇄, an accent) then crashes the moment it is `.strip`ed or joined with the UTF-8 markdown we
# build (Encoding::CompatibilityError). The shell hands us UTF-8 bytes, so re-tagging is correct;
# `.scrub` keeps even malformed bytes non-fatal.
ARGV.map! { |a| a.dup.force_encoding("UTF-8").scrub }

# One shared client for the whole invocation (reads LINEAR_API_KEY from ENV; memoizes teams/states).
# The workspace may be multi-team; the client resolves any team by key.
CLIENT = Linear::Client.new

# Default team for `create`/`list` when no --team is given: $LINEAR_DEFAULT_TEAM if set, else nil — a
# team must then come from --team or the command errors. A per-command --team always wins.
# Identifier-based commands (view/close/comment/start/review/label/…) need no team — they resolve it
# from the issue id.
def default_team
  t = ENV["LINEAR_DEFAULT_TEAM"].to_s.strip
  t.empty? ? nil : t
end

# UTC timestamp used in the auto-generated comment bodies (session start, merged SHA, reopen).
def ts
  Time.now.utc.strftime("%Y-%m-%dT%H:%MZ")
end

# --- Commit links --------------------------------------------------------------
# Linear renders a clickable GitHub link from any commit we attach. Resolving the ref + subject is a
# local-git concern, so it stays in the CLI; the resulting markdown is posted via CLIENT.comment.

# Run a git command and return its stdout as a UTF-8 string. Ruby tags backtick output with
# Encoding.default_external; when that is US-ASCII, a commit subject carrying a non-ASCII char (e.g. a
# ⇄) makes the very first `.strip` raise Encoding::CompatibilityError, crashing `linear commit`. git
# emits UTF-8, so re-tag the bytes as UTF-8 before any string op; `.scrub` makes even genuinely
# malformed bytes non-fatal.
def git_capture(cmd)
  `#{cmd}`.force_encoding("UTF-8").scrub
end

# True when `cmd` exits 0. For the git queries whose ANSWER is the exit status rather than the output
# (`merge-base --is-ancestor`, `rev-parse --verify`); stdout/stderr are discarded.
def git_ok?(cmd)
  system("#{cmd} >/dev/null 2>&1") ? true : false
end

# --- Which repo is this commit in? ---------------------------------------------
# AGT-212. The commit link used to be built from the invoking checkout's `origin` whether or not the
# SHA was in that repo. That assumption breaks the moment `bin/linear` is reached through a shim in
# one repo while the work being shipped lives in another: the cwd's origin is not the commit's repo,
# so the link is minted against a repo the SHA was never in. Measured four times over six weeks —
# a github.com/<owner>/<name>/commit/<sha> link that 404s, on the ticket's permanent audit trail.
#
# A missing link costs a reader one `git show`. A WRONG one sends them hunting through a repo the
# commit was never in, weeks later, which is exactly when the trail matters. So: prove it or omit it.

# The owner/name slug of the repo the INVOKING working directory is in, from its `origin` remote —
# SSH, ssh:// and HTTPS forms. nil when there is no origin, or origin isn't GitHub.
#
# Resolved from the cwd at call time, never from where this gem or a host's `bin/linear` shim lives:
# a shim is `load`ed by the app that owns it, so its location says nothing about which repo the
# ticket's work is in.
def origin_slug
  url = git_capture("git remote get-url origin 2>/dev/null").strip
  return nil if url.empty?

  case url
  when %r{\Agit@github\.com:(.+?)(?:\.git)?\z}       then $1
  when %r{\Assh://git@github\.com/(.+?)(?:\.git)?\z} then $1
  when %r{\Ahttps://github\.com/(.+?)(?:\.git)?\z}   then $1
  end
end

# `--repo owner/name` — the escape hatch for the cross-repo case: standing in one checkout, linking a
# commit that lives in another. Validated, since it is spliced into a URL we publish.
def validated_slug(repo)
  return nil if repo.nil?

  abort "Invalid --repo #{repo.inspect} — expected owner/name (e.g. octocat/hello-world)." unless
    repo.to_s =~ %r{\A[A-Za-z0-9._-]+/[A-Za-z0-9._-]+\z}

  repo
end

# Reject anything that isn't a plain git ref so the ref is safe to splice into the `git` shell-outs
# below (no command injection from --sha values).
def safe_ref(ref)
  abort "Invalid git ref: #{ref.inspect}" unless ref.to_s =~ %r{\A[A-Za-z0-9_./^~@-]+\z}

  ref
end

# Origin's default branch as a ref name ("origin/main") — from `origin/HEAD` when the checkout has
# one, else whichever of origin/main / origin/master exists. nil when the checkout tracks nothing.
def default_remote_branch
  head = git_capture("git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null").strip
  return head unless head.empty?

  %w[origin/main origin/master].find { |ref| git_ok?("git rev-parse --verify --quiet #{ref}") }
end

# What can be PROVED about a commit from this checkout, locally:
#   :merged   an ancestor of origin's default branch — it landed
#   :pushed   some origin/* ref contains it — on the remote, on a branch/PR, but not on main
#   :local    the object is here, no origin ref contains it — committed, not pushed
#   :unknown  the object isn't in this checkout at all — this checkout can prove nothing about it
#
# Remote-tracking refs can be stale, which only ever makes this UNDER-claim (a merge fetched by
# nobody reads as :pushed). Under-claiming is the safe direction for a sentence a reader uses to
# decide whether work shipped.
def commit_state(full, branch)
  return :unknown if full.empty?
  return :merged  if branch && git_ok?("git merge-base --is-ancestor #{full} #{branch}")

  git_capture("git branch --remotes --contains #{full} 2>/dev/null").strip.empty? ? :local : :pushed
end

# One resolved --sha: the markdown to post, the repo it was linked into (nil when unlinkable), and
# what this checkout can prove about where it is. Resolved in a single pass so the link and the
# claims about it can never disagree.
CommitRef = Struct.new(:ref, :full, :slug, :markdown, :state, :branch)

def resolve_commit(ref, repo: nil)
  ref    = safe_ref(ref)
  full   = git_capture("git rev-parse --verify --quiet #{ref}^{commit} 2>/dev/null").strip
  # An override is the caller's assertion and wins. Otherwise the cwd's origin is only this commit's
  # repo if the commit is actually IN this checkout — that check is the whole fix.
  slug   = validated_slug(repo) || (full.empty? ? nil : origin_slug)
  branch = default_remote_branch

  markdown =
    if slug.nil?
      warn_unlinkable(ref, full, origin_slug)
      full.empty? ? "`#{ref}`" : "`#{full[0, 8]}`"
    elsif full.empty?
      "[`#{ref}`](https://github.com/#{slug}/commit/#{ref})"
    else
      link    = "[`#{full[0, 8]}`](https://github.com/#{slug}/commit/#{full})"
      subject = git_capture("git log -1 --format=%s #{full} 2>/dev/null").strip
      subject.empty? ? link : "#{link} #{subject}"
    end

  CommitRef.new(ref, full, slug, markdown, commit_state(full, branch), branch)
end

# Say why a SHA went out bare, on stderr, so the omission reads as a deliberate choice rather than a
# broken link — and name the flag that fixes it.
def warn_unlinkable(ref, full, origin)
  if full.empty?
    warn "  ! #{ref} is not a commit in this checkout#{origin ? " (#{origin})" : ""} — " \
         "posting the SHA without a link, since a link built from this repo would 404 (AGT-212)."
    warn "    fix: run this from the checkout the commit is in, or pass --repo owner/name."
  else
    warn "  ! no GitHub `origin` remote here — posting the SHA without a link. Pass --repo owner/name to link it."
  end
end

# Markdown for a commit reference: a clickable short-SHA link to GitHub + the commit subject, or a
# bare `sha` when the repo can't be established. Kept as its own entry point for `commit`, which
# needs the markdown and none of the merge/deploy reasoning.
def commit_markdown(ref, repo: nil)
  resolve_commit(ref, repo: repo).markdown
end

# --- Does this repo deploy? ----------------------------------------------------
# The In Review comment used to end "— <Platform> deploy in progress" unconditionally, which is
# false for every repo that has no deploy pipeline at all and for every one that ships by some
# route this tool knows nothing about. So the clause is emitted only for a repo KNOWN to deploy,
# and only once the commit is actually on main — a deploy is triggered by landing, not by moving a
# ticket to In Review.
#
# AGT-270: the allowlist is empty by default. Nothing this tool ships can know which repos deploy or
# what they deploy to, and a wrong guess writes an unearned claim onto a permanent audit trail, so
# the knowledge has to come from the caller: $LINEAR_CLI_DEPLOY_REPOS as a comma-separated list of
# `owner/name` or `owner/name=Platform` (unset or empty means "nothing here deploys"), or per-call
# with --deploy / --no-deploy.
DEPLOY_REPOS_ENV     = "LINEAR_CLI_DEPLOY_REPOS"
DEFAULT_DEPLOY_REPOS = {}.freeze

def deploy_repos
  raw = ENV[DEPLOY_REPOS_ENV]
  return DEFAULT_DEPLOY_REPOS if raw.nil?

  raw.split(",").filter_map do |entry|
    slug, platform = entry.strip.split("=", 2)
    next if slug.nil? || slug.empty?

    [slug, platform.to_s.strip.empty? ? nil : platform.strip]
  end.to_h
end

# The deploy platform's name for a repo ("Kamal"), nil for a repo that deploys namelessly, and
# :none for one that does not deploy — three states, so "not in the list" stays distinguishable from
# "in the list, no platform name".
def deploy_platform(slug)
  repos = deploy_repos
  return :none unless slug && repos.key?(slug)

  repos[slug]
end

# --- Screenshots ---------------------------------------------------------------
# Linear renders any markdown image whose URL is a Linear asset URL. To get one we ask Linear for a
# signed upload slot (CLIENT.request_file_upload — the GraphQL half), PUT the bytes to the storage
# URL (local-file I/O, here), then embed ![..](assetUrl). Used by create/comment (--image) + attach.

IMAGE_CONTENT_TYPES = {
  ".png" => "image/png", ".jpg" => "image/jpeg", ".jpeg" => "image/jpeg",
  ".gif" => "image/gif", ".webp" => "image/webp"
}.freeze

def content_type_for(path)
  ext = File.extname(path).downcase
  IMAGE_CONTENT_TYPES[ext] ||
    abort("Unsupported image type #{ext.inspect} for #{path} — use png/jpg/jpeg/gif/webp")
end

# Upload a local image to Linear; returns the public assetUrl to embed as markdown.
def upload_image(path)
  abort "Image not found: #{path}" unless File.file?(path)

  bytes        = File.binread(path)
  content_type = content_type_for(path)
  filename     = File.basename(path)

  uf = CLIENT.request_file_upload(content_type: content_type, filename: filename, size: bytes.bytesize)
  abort "Linear refused the upload for #{filename}" unless uf && uf["uploadUrl"]

  # PUT the raw bytes to the signed storage URL. No Authorization header here — the URL is
  # pre-signed; we only echo back the headers Linear hands us plus Content-Type.
  upload_uri = URI(uf["uploadUrl"])
  http = Net::HTTP.new(upload_uri.host, upload_uri.port)
  http.use_ssl = (upload_uri.scheme == "https")
  put = Net::HTTP::Put.new(upload_uri.request_uri)
  put["Content-Type"] = content_type
  (uf["headers"] || []).each { |h| put[h["key"]] = h["value"] }
  put.body = bytes
  res = http.request(put)
  unless res.is_a?(Net::HTTPSuccess)
    abort "Upload PUT failed for #{filename}: HTTP #{res.code} #{res.message}"
  end
  uf["assetUrl"]
end

# Upload each path and return a markdown block of inline images (blank-line separated).
def images_markdown(paths)
  return "" if paths.nil? || paths.empty?

  paths.map { |p| "![#{File.basename(p)}](#{upload_image(p)})" }.join("\n\n")
end

# Join non-empty text fragments with blank lines (for body + screenshot blocks).
def join_md(*parts)
  parts.flatten.reject { |s| s.nil? || s.to_s.strip.empty? }.join("\n\n")
end

# --- file-based bodies + flag validation (AGT-83) ------------------------------
# Multi-line markdown with backticks/parens breaks under bash command substitution when passed as a
# --desc / comment arg, so create + comment also accept a PATH to read the body from a file. And a
# mistyped flag (the `comment ISSUE-N --show` typo that posted a stray no-op comment) is now rejected
# instead of being swallowed as input.

# Read a markdown body from a file (for --desc-file / --body-file), or from STDIN when the path is "-".
# The "-" / stdin form is the robust way to pass complex multi-line markdown: a caller pipes a
# SINGLE-QUOTED heredoc (`--body-file - <<'MD' … MD`), which suppresses ALL shell expansion, so code
# fences / backticks / `$VAR` / `\` reach the gem byte-for-byte instead of being mangled by bash
# command substitution + variable expansion the way a double-quoted positional body is (AGT-201).
# Re-tags as UTF-8 (file/STDIN bytes may be ASCII-8BIT) so it joins cleanly with the UTF-8 markdown we
# build; `.scrub` keeps bad bytes non-fatal.
def read_body_file(path)
  return $stdin.read.to_s.force_encoding("UTF-8").scrub if path == "-"

  abort "Body file not found: #{path}" unless File.file?(path)

  File.read(path).force_encoding("UTF-8").scrub
end

# --- usage + argument guards ----------------------------------------------------------------------

# The argument shape of every subcommand, keyed by its canonical name. One source of truth for three
# readers: the `abort` when a required argument is missing, the per-subcommand `--help` output, and
# the argument guards' "run X --help" hint (AGT-276). The full command list for a bare `linear` is a
# separate, annotated block at the bottom of this file.
SUBCOMMAND_USAGE = {
  "create"         => %(create "Title" [--team KEY] [--label X] [--priority X] [--desc "body"] [--image PATH ...] [--parent ISSUE-N] [--blocked-by ISSUE-N] [--blocks ISSUE-N] [--related ISSUE-N]),
  "search"         => %(search "<keywords>" [--limit N]),
  "list"           => %(list [--status todo|in_progress|done] [--label Bug] [--team KEY] [--limit N]),
  "view"           => %(view ISSUE-N),
  "url"            => %(url ISSUE-N),
  "retitle"        => %(retitle ISSUE-N "New title"),
  "priority"       => %(priority ISSUE-N urgent|high|medium|low|none),
  "set"            => %(set ISSUE-N [--priority X] [--assignee me|email] [--estimate N] [--due YYYY-MM-DD] [--label NAME]),
  "edit"           => %(edit ISSUE-N [--title "New title"] [--desc "body" | --desc-file PATH|-]  (--desc-file - reads STDIN; at least one of --title/--desc)),
  "reopen"         => %(reopen ISSUE-N [--in-progress] ["why it recurred" | --comment "why it recurred" | --comment-file PATH|-]),
  "parent"         => %(parent CHILD PARENT),
  "relate"         => %(relate ISSUE-N ISSUE-M [--type related|blocks|blocked-by|duplicate|similar]),
  "unrelate"       => %(unrelate ISSUE-N ISSUE-M),
  "start"          => %(start ISSUE-N [--session "name"]),
  "review"         => %(review ISSUE-N [--sha <sha>] [--repo owner/name] [--merged|--not-merged] [--deploy|--no-deploy]),
  "commit"         => %(commit ISSUE-N [--sha <ref>] [--note "context"] [--repo owner/name]),
  "comment"        => %(comment ISSUE-N "body" | --body-file PATH|- [--image PATH ...]  (--body-file - reads STDIN)),
  "comments"       => %(comments ISSUE-N),
  "comment-edit"   => %(comment-edit ISSUE-N <comment-id> "new body" | --body-file PATH|-),
  "comment-delete" => %(comment-delete ISSUE-N <comment-id>),
  "attach"         => %(attach ISSUE-N PATH [PATH ...] [--note "caption"]),
  "label"          => %(label ISSUE-N <label>),
  "close"          => %(close ISSUE-N ["reason" | --comment "reason" | --comment-file PATH|-]),
  "cancel"         => %(cancel ISSUE-N ["reason" | --comment "reason" | --comment-file PATH|-])
}.freeze

# Subcommand aliases → canonical name, so `rename --help` answers with retitle's usage.
SUBCOMMAND_ALIASES = { "rename" => "retitle", "prio" => "priority", "edit-desc" => "edit" }.freeze

def canonical_subcommand(cmd)
  SUBCOMMAND_ALIASES.fetch(cmd.to_s, cmd.to_s)
end

def usage_for(cmd)
  "Usage: #{PROG} #{SUBCOMMAND_USAGE.fetch(canonical_subcommand(cmd))}"
end

# `--help` / `-h` is the most-typed wrong token on a subcommand, and until AGT-276 every subcommand
# treated it as DATA rather than as a question: `create --help` filed a real ticket titled "--help"
# (AKA-1338 on 2026-07-29, which had to be canceled by hand) and `retitle ISSUE-N --help` renamed the
# issue to "--help". It is answered in `run`, BEFORE any parser runs, so the one token you type when
# you are least sure of the syntax can no longer mutate anything.
#
# Only tokens before a POSIX `--` count, so `create -- --help` still files a ticket genuinely titled
# "--help" rather than printing usage at someone who asked for exactly that.
def help_requested?(argv)
  argv.take_while { |a| a != "--" }.any? { |a| ["--help", "-h"].include?(a) }
end

# Shift the next POSITIONAL argument off `args`, refusing a `--flag` token in that slot.
#
# Every parser here shifts its positionals BEFORE its flag loop runs, so a `--flag` in that slot never
# reaches the `/\A--/` guard AGT-209 added — it silently becomes the VALUE. Where that value is free
# text the damage is silent AND destructive: a ticket filed with a nonsense title, or a title
# overwritten by one. (Where it is an issue id, `find_issue!` already fails loudly, so those slots are
# left as they were.) `what` names the slot in the error. (AGT-276)
#
# A leading `--` is the POSIX escape: it consumes itself and the next token is taken literally, so a
# value that genuinely starts with dashes stays expressible (`create -- --dashy-title`). It escapes
# exactly ONE token and flag parsing resumes after it — `create -- --dashy-title --label Bug` still
# gets its label, rather than swallowing the rest of the line as positionals and dropping it.
def take_positional!(args, cmd, what)
  if args.first == "--"
    args.shift
    escaped = args.shift
    abort "#{PROG} #{cmd}: `--` must be followed by the #{what}.\n#{usage_for(cmd)}" if escaped.nil?

    return escaped
  end

  value = args.shift
  abort usage_for(cmd) if value.nil?
  return value unless value.start_with?("--")

  abort "#{PROG} #{cmd}: #{value.inspect} is a flag, not the #{what} — refusing to use it as the #{what}.\n" \
        "  ↳ usage:  #{PROG} #{cmd} --help\n" \
        "  ↳ a #{what} that really starts with dashes: put a bare `--` in front of it."
end

# The value of a flag that NAMES something (a title, a label) rather than carrying prose — the same
# failure as take_positional!, one token to the right: `edit ISSUE-N --title --help` renamed the issue
# to "--help" because the parser takes args[i + 1] verbatim (AGT-276).
#
# Prose flags (--desc / --comment / --note / --session) are deliberately NOT routed through here:
# markdown legitimately starts with `---`, and the `--help` gate in `run` already answers the only
# token that actually gets typed into them by mistake.
def named_value!(args, index, flag, cmd, what)
  value = args[index + 1]
  abort "#{PROG} #{cmd}: #{flag} requires a #{what}." if value.nil?
  return value unless value.start_with?("--")

  abort "#{PROG} #{cmd}: #{flag} #{value.inspect} is a flag, not a #{what}.\n  ↳ usage:  #{PROG} #{cmd} --help"
end

# A count flag whose value is not a positive integer must ABORT, not coerce to 0. `search "x" --limit
# abc` quietly became limit 0 and printed "No candidates … safe to create a new one" — a dedup search
# that invites the duplicate it exists to prevent. `list` was fixed for this in AGT-224; `search` had
# the identical hole, so the check lives here once and both call it (AGT-275).
def positive_int!(value, cmd, flag)
  n = begin
    Integer(value.to_s.strip, 10)
  rescue ArgumentError, TypeError
    abort "#{PROG} #{cmd}: #{flag} takes a positive integer, got #{value.inspect}"
  end
  abort "#{PROG} #{cmd}: #{flag} must be positive, got #{n}" unless n.positive?

  n
end

# Abort with a clear message if any unrecognized --flags were collected, so a fat-finger (e.g. --show)
# can't be silently treated as input. `cmd` names the subcommand in the error.
def reject_unknown_flags!(unknown, cmd)
  return if unknown.nil? || unknown.empty?

  abort "Unknown flag(s) for #{cmd}: #{unknown.join(" ")} — run `#{PROG}` with no args for usage."
end

# Value that follows a value-taking flag, aborting when it is missing instead of binding nil. A
# dangling `--comment` at the end of ARGV would otherwise leave the body nil and transition the issue
# with no comment at all — the same silent drop as AGT-209, one token further along.
def flag_value!(args, index, flag, cmd)
  value = args[index + 1]
  abort "#{PROG} #{cmd}: #{flag} requires a value." if value.nil?

  value
end

# Resolve the [BODY | --comment "text" | --comment-file PATH|-] trio shared by the transition
# commands (close/cancel/reopen). `--comment-file` reuses read_body_file, so `-` reads STDIN — the
# single-quoted-heredoc form that survives the shell (AGT-201) — and a missing path aborts HERE,
# before the caller transitions anything, so a closing writeup that could not be read never leaves the
# issue Done with nothing attached.
#
# A bare positional is the third source (AGT-277). It used to be stepped over in silence, so
# `close ISSUE-N "verified on prod"` closed the issue and dropped the writeup with no error and exit
# 0. It is read as the body now because that is unambiguously what the caller meant: `comment ISSUE-N
# "body"` is the shape they already know, so typing it at `close` is the natural mistake and the
# natural spelling. The three sources are mutually exclusive on purpose: silently preferring one
# would be the same quiet wrong-body class this whole guard exists for (AGT-267).
def resolve_comment_flags!(comment, comment_file, cmd:, positionals: [])
  body_arg, *extra = positionals
  # An UNQUOTED body — `close ISSUE-N verified on prod` — reaches us pre-split by the shell. Joining
  # it back would attach a body whose whitespace is no longer the one that was typed, so name the
  # leftovers instead: a guessed body is the thing this ticket is about.
  unless extra.empty?
    abort "#{PROG} #{cmd}: unexpected extra argument(s) after the comment body: " \
          "#{extra.map(&:inspect).join(", ")} — quote the whole body as ONE argument " \
          "(#{PROG} #{cmd} ISSUE-N \"...\"), or pass it with --comment-file - and a heredoc."
  end

  sources = { "the body argument" => body_arg, "--comment" => comment, "--comment-file" => comment_file }
            .reject { |_, v| v.nil? }
  if sources.length > 1
    names = sources.keys.join(" or ")
    abort "Pass either #{names}, not both." if sources.length == 2

    abort "Pass exactly one of #{names} — you gave #{sources.length}."
  end

  flag, raw = sources.first
  body = flag == "--comment-file" ? read_body_file(raw) : raw
  # A blank body reaching the client is a no-op there (`add_comment if comment && !comment.empty?`),
  # so the command would print its success line AND "Comment added." having attached nothing — the
  # exact false signal this pair of tickets exists to remove, just reached by a different door (an
  # empty heredoc, a generated file that came out empty). Asking again costs a retry; a Done ticket
  # with a missing writeup costs the writeup.
  abort "#{PROG}: #{flag} was given but the body is empty." if body && body.strip.empty?

  body
end

# Abort naming any leftover POSITIONAL arguments, for the transition commands that have NO body to
# put one in (start/review/relate). v2.12.0 made all six reject unknown FLAGS, but their `else i += 1`
# branch went on stepping over bare words in silence, so `review ISSUE-N abc1234` moved the issue to
# In Review and dropped the SHA (AGT-277). Nothing here can guess what an extra word meant — close and
# friends can, which is why they read it as the body instead of calling this.
def reject_unknown_positionals!(positionals, cmd, usage)
  return if positionals.nil? || positionals.empty?

  abort "#{PROG} #{cmd}: unexpected argument(s): #{positionals.map(&:inspect).join(", ")} — #{usage}"
end

# Human-readable parent / sub-issue / relation lines for an issue node returned by
# CLIENT.find_issue (carries parent/children/relations/inverseRelations). Pure formatting.
def format_issue_links(issue)
  out = []
  if (par = issue.dig("parent", "identifier"))
    out << "parent (epic): #{par}"
  end
  kids = issue.dig("children", "nodes")&.map { |c| c["identifier"] } || []
  out << "sub-issues:    #{kids.join(", ")}" if kids.any?
  (issue.dig("relations", "nodes") || []).each do |r|
    verb = { "blocks" => "blocks", "duplicate" => "duplicate of", "similar" => "similar to" }[r["type"]] || "related to"
    out << "#{verb} #{r.dig("relatedIssue", "identifier")}"
  end
  (issue.dig("inverseRelations", "nodes") || []).each do |r|
    verb = { "blocks" => "blocked by", "duplicate" => "duplicated by", "similar" => "similar to" }[r["type"]] || "related to"
    out << "#{verb} #{r.dig("issue", "identifier")}"
  end
  out
end

def cmd_create(args)
  title = take_positional!(args, "create", "title")
  label_name, priority_name, description = nil, "medium", nil
  images = []
  parent_ref = nil
  blocks_refs, blocked_by_refs, related_refs = [], [], []
  team_key = default_team   # --team KEY > $LINEAR_DEFAULT_TEAM (no hardcoded fallback)
  positionals = []
  unknown = []

  i = 0
  while i < args.length
    case args[i]
    when "--team"                   then team_key      = named_value!(args, i, "--team", "create", "team key"); i += 2
    when "--label"                  then label_name    = named_value!(args, i, "--label", "create", "label name"); i += 2
    when "--priority"               then priority_name = named_value!(args, i, "--priority", "create", "priority word"); i += 2
    # --desc/--desc-file carry PROSE, so they take flag_value! rather than named_value!: markdown
    # legitimately starts with `---`, and only the MISSING-value half applies (AGT-276's split).
    when "--desc", "--description"  then description   = flag_value!(args, i, args[i], "create"); i += 2
    when "--desc-file", "--description-file" then description = read_body_file(flag_value!(args, i, args[i], "create")); i += 2
    when "--image"                  then images       << named_value!(args, i, "--image", "create", "path"); i += 2
    when "--parent"                 then parent_ref     = named_value!(args, i, "--parent", "create", "issue id"); i += 2
    when "--blocks"                 then blocks_refs   << named_value!(args, i, "--blocks", "create", "issue id"); i += 2
    when "--blocked-by", "--depends-on", "--after" then blocked_by_refs << named_value!(args, i, args[i], "create", "issue id"); i += 2
    when "--related", "--relates-to"               then related_refs    << named_value!(args, i, args[i], "create", "issue id"); i += 2
    when /\A--/                     then unknown      << args[i]; i += 1
    else positionals << args[i]; i += 1
    end
  end
  reject_unknown_flags!(unknown, "create")
  # A stray positional was stepped over in silence, so an UNQUOTED multi-word title filed a ticket
  # named after its first word — `create Fix the parser` filed "Fix" and dropped the rest. `create`
  # has no body positional to absorb it the way AGT-277 gave `comment`/`close` one, so it is an
  # error: the same "never a silent drop" rule, reached by the only door left open (AGT-275).
  unless positionals.empty?
    abort "#{PROG} create: unexpected extra argument(s) #{positionals.map(&:inspect).join(" ")} — " \
          "quote the whole title, and pass a body with --desc/--desc-file."
  end

  # Always attach screenshots when given — uploaded and embedded under a Screenshots heading. (Image
  # upload is a local-file concern, so the CLI builds the final description, then hands it to the client.)
  if images.any?
    description = join_md(description, "**Screenshots**", images_markdown(images))
  end

  result = CLIENT.create(
    title: title, label: label_name, priority: priority_name, description: description, team: team_key,
    parent: parent_ref, blocks: blocks_refs, blocked_by: blocked_by_refs, related: related_refs
  )
  issue = result[:issue]
  puts "#{issue["identifier"]}: #{issue["title"]}"
  puts issue["url"]

  # --- Dependency links — applied AT create time so they're never forgotten ----
  result[:links].each do |lk|
    verb = { "parent" => "↳ sub-issue of", "blocks" => "↳ blocks",
             "blocked_by" => "↳ blocked by", "related" => "↳ related to" }[lk[:kind]]
    if lk[:ok]
      puts "  #{verb} #{lk[:identifier]}"
    else
      warn "  ! could not link #{lk[:kind].tr("_", " ")} #{lk[:ref]}"
    end
  end
end

def cmd_view(args)
  identifier = args.shift or abort usage_for("view")
  issue = CLIENT.find_issue(identifier)
  abort "Issue #{identifier} not found" unless issue

  puts "#{issue["identifier"]}: #{issue["title"]}"
  puts "  State:    #{issue.dig("state", "name")}"
  puts "  Priority: #{CLIENT.priority_label(issue["priority"])}"
  puts "  Assignee: #{issue.dig("assignee", "name") || "unassigned"}"
  puts "  Labels:   #{issue.dig("labels", "nodes")&.map { |l| l["name"] }&.join(", ") || "none"}"
  puts "  URL:      #{issue["url"]}"
  links = format_issue_links(issue)
  unless links.empty?
    puts "  Links:    #{links.first}"
    links.drop(1).each { |l| puts "            #{l}" }
  end
  puts  ""
  puts issue["description"] if issue["description"] && !issue["description"].empty?

  # List comment ids so they're discoverable for `comment-edit` / `comment-delete` (a separate query
  # — find_issue stays lean for the hot transition path).
  list = CLIENT.comments(identifier)
  unless list.empty?
    puts ""
    puts "Comments (#{list.length}) — id for `#{PROG} comment-edit`/`comment-delete`:"
    list.each { |c| puts "  #{comment_line(c)}" }
  end
end

# One-line summary of a comment node for `view` / `comments`: id, timestamp, author, and the first
# line of the body (truncated). Used wherever comment ids are surfaced.
def comment_line(c)
  who     = c.dig("user", "name") || "?"
  first   = c["body"].to_s.strip.split("\n").first.to_s
  snippet = first.length > 70 ? "#{first[0, 70]}…" : first
  base    = "#{c["id"]}  #{c["createdAt"]}  @#{who}"
  snippet.empty? ? base : "#{base}  #{snippet}"
end

# List an issue's comments with their ids (the discoverability surface for comment-edit/delete).
def cmd_comments(args)
  identifier = args.shift or abort usage_for("comments")
  list = CLIENT.comments(identifier)
  if list.empty?
    puts "No comments on #{identifier}."
    return
  end
  puts "#{list.length} comment(s) on #{identifier} (id  time  author  first line):"
  list.each { |c| puts comment_line(c) }
end

# Edit an existing comment's body by comment id. New body comes from the positional arg or --body-file
# (the file form avoids shell-escaping multi-line markdown). The comment must belong to ISSUE-N.
def cmd_comment_edit(args)
  identifier = args.shift or abort usage_for("comment-edit")
  comment_id = args.shift or abort usage_for("comment-edit")
  body_file = nil
  positionals = []
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--body-file" then body_file = args[i + 1]; i += 2
    # POSIX end-of-options: everything after `--` is the body (a `--`-leading body isn't a flag).
    when "--"          then positionals.concat(args[(i + 1)..] || []); break
    when /\A--/        then unknown << args[i]; i += 1
    else positionals << args[i]; i += 1
    end
  end
  reject_unknown_flags!(unknown, "comment-edit")

  body = positionals.shift
  if body_file
    abort "Pass either a body argument or --body-file, not both." if body
    body = read_body_file(body_file)
  end
  abort usage_for("comment-edit") if body.nil? || body.strip.empty?

  ensure_comment_on_issue!(identifier, comment_id)
  CLIENT.update_comment(comment_id, body)
  puts "Updated comment #{comment_id} on #{identifier}."
end

