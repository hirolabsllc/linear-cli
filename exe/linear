# General field setter — change priority/assignee/estimate/due/label in one call so each field no
# longer needs a one-off raw GraphQL mutation. Any subset of flags; prints each old → new change.
def cmd_set(args)
  identifier = args.shift or abort usage_for("set")
  priority = assignee = estimate = due = nil
  labels  = []
  unknown = []
  i = 0
  while i < args.length
    case args[i]
    when "--priority" then priority = args[i + 1]; i += 2
    when "--assignee" then assignee = args[i + 1]; i += 2
    when "--estimate" then estimate = args[i + 1]; i += 2
    when "--due"      then due      = args[i + 1]; i += 2
    when "--label"    then labels  << named_value!(args, i, "--label", "set", "label name"); i += 2
